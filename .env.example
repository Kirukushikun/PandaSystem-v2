# ==========================================================================
# Application
# ==========================================================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ==========================================================================
# Logging
# ==========================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================================================
# Database
# ==========================================================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ==========================================================================
# Backups (spatie/laravel-backup — local disk + optional Google Drive offsite,
# see App\Livewire\Maintenance\Backups / App\Providers\GoogleDriveServiceProvider)
# ==========================================================================
# Directory containing mysqldump/mysql — required in production if mysql-client
# isn't guaranteed to be on the web server process's PATH (e.g. inside a Docker
# image). Windows/Laragon example: C:\laragon\bin\mysql\mysql-8.x.x\bin
# Ubuntu example: /usr/bin
# DB_DUMP_BINARY_PATH=

# Leave GOOGLE_DRIVE_REFRESH_TOKEN blank to run local-disk-only; setup steps
# are in project-overview's "Spatie Backup to Google Drive Setup" doc.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER="BGC System Backups/PANDASystem"

# Where backup-failure/health-check emails go — falls back to 'your@example.com'
# (i.e. effectively disabled) if left blank.
# BACKUP_NOTIFICATION_EMAIL=

# ==========================================================================
# Session / Cache / Queue / Broadcasting
# ==========================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================================================
# Mail
# ==========================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================================
# AWS S3 — unused (attachments/e-signs and backups both live on local disks;
# kept only as Laravel's default scaffolded disk in config/filesystems.php)
# ==========================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================================================
# External Auth / User Directory API (org standard —
# authentication-implementation-guide.md). PANDA never stores passwords.
# ==========================================================================
AUTH_API_BASE_URI=
AUTH_API_KEY=
AUTH_USER_API_KEY=

# User Listing API (User Management panel)
USER_API_ENDPOINT=
USER_API_KEY=

# Cloudflare Turnstile bot protection on the login form
TURNSTILE_VERIFY=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dev-only: bypass the external Auth API (provider is offline after office hours).
# Any password works for a seeded users.email. Hard-disabled in production.
AUTH_FAKE=false

# ==========================================================================
# Real-time notifications (Laravel Reverb — in-app bell only, no OS push)
# Generated by `php artisan reverb:install`; needs its own running process —
# `php artisan reverb:start`, separate from `php artisan serve`/`npm run dev`.
# ==========================================================================
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
